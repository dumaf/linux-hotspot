#!/usr/bin/env bash
# Linux Hotspot Manager - Same-Channel Wi-Fi AP with Packet Engine
# Usage: sudo ./hotspot {start|stop|status|qr}

set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONF_FILE="${SCRIPT_DIR}/hotspot.conf"
STATE_DIR="/run/linux-hotspot"
PACKET_ENGI NE="${SCRIPT_DIR}/packet_engine"

# ── Defaults ──────────────────────────────────────────────────────────────────
SSID="LinuxHotspot"
PASSWORD="MySecurePassword123"
WIFI_IFACE=""
SUBNET="192.168.12.1/24"
DHCP_START="192.168.12.20"
DHCP_END="192.168.12.250"
DNS1="1.1.1.1"
DNS2="8.8.8.8"

# Derived
AP_IFACE=""
GW_IP=""
SUBNET_PREFIX=""
STA_CHANNEL=""
STA_FREQ=""

# ── Helpers ───────────────────────────────────────────────────────────────────
log()  { printf '\033[1;32m[hotspot]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[hotspot] WARNING:\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[hotspot] ERROR:\033[0m %s\n' "$*" >&2; exit 1; }

require_root() {
    [[ $EUID -eq 0 ]] || die "This script must be run as root (use sudo)."
}

load_conf() {
    if [[ -f "$CONF_FILE" ]]; then
        # shellcheck disable=SC1090
        source "$CONF_FILE"
        log "Loaded configuration from $CONF_FILE"
    else
        warn "No config file found at $CONF_FILE, using defaults."
    fi
    GW_IP="${SUBNET%%/*}"
    SUBNET_PREFIX="${GW_IP%.*}"
}

# ── Wi-Fi Detection ──────────────────────────────────────────────────────────
detect_wifi_iface() {
    if [[ -n "$WIFI_IFACE" ]]; then
        if [[ ! -d "/sys/class/net/$WIFI_IFACE/wireless" ]]; then
            die "Specified interface '$WIFI_IFACE' is not a wireless interface."
        fi
        return
    fi
    # Auto-detect: find the first wireless interface
    local iface
    for iface in /sys/class/net/*/wireless; do
        iface="${iface%/wireless}"
        iface="${iface##*/}"
        WIFI_IFACE="$iface"
        break
    done
    [[ -n "$WIFI_IFACE" ]] || die "No wireless interface found."
    log "Auto-detected Wi-Fi interface: $WIFI_IFACE"
}

detect_sta_channel() {
    # Get the current channel and frequency of the STA connection
    local info
    info="$(iw dev "$WIFI_IFACE" info 2>/dev/null || true)"
    STA_CHANNEL="$(echo "$info" | grep -oP 'channel \K[0-9]+' | head -1 || true)"
    STA_FREQ="$(echo "$info" | grep -oP 'channel [0-9]+ \(\K[0-9]+' | head -1 || true)"

    if [[ -z "$STA_CHANNEL" ]]; then
        # Fallback: try iwconfig
        STA_CHANNEL="$(iwconfig "$WIFI_IFACE" 2>/dev/null | grep -oP 'Channel[=:]\K[0-9]+' || true)"
        STA_FREQ="$(iwconfig "$WIFI_IFACE" 2>/dev/null | grep -oP 'Frequency[=:]\K[0-9.]+' || true)"
    fi

    if [[ -z "$STA_CHANNEL" ]]; then
        warn "Could not detect current Wi-Fi channel, defaulting to channel 6."
        STA_CHANNEL="6"
        STA_FREQ="2437"
    fi
    log "Current STA channel: $STA_CHANNEL (freq: ${STA_FREQ:-unknown} MHz)"
}

pick_ap_iface() {
    local n=0
    while ip link show "ap${n}" &>/dev/null; do
        n=$((n + 1))
    done
    AP_IFACE="ap${n}"
    log "Selected AP interface: $AP_IFACE"
}

check_ap_support() {
    local phy
    phy="$(basename "$(readlink -f "/sys/class/net/$WIFI_IFACE/phy80211" 2>/dev/null || echo "")" 2>/dev/null || true)"
    if [[ -z "$phy" ]]; then
        phy="$(iw dev "$WIFI_IFACE" info 2>/dev/null | grep -oP 'wiphy \K[0-9]+' || true)"
        [[ -n "$phy" ]] && phy="phy${phy}"
    fi
    if [[ -z "$phy" ]]; then
        warn "Could not determine phy for $WIFI_IFACE, proceeding anyway."
        return
    fi
    # Check for AP mode and combo support
    local modes
    modes="$(iw phy "$phy" info 2>/dev/null || true)"
    if ! echo "$modes" | grep -qP '^\s+\* AP$'; then
        die "Wi-Fi hardware ($phy) does not support AP mode."
    fi
    log "Wi-Fi hardware ($phy) supports AP mode."
}

# ── Hotspot Lifecycle ─────────────────────────────────────────────────────────
create_ap_interface() {
    log "Creating virtual AP interface $AP_IFACE on $WIFI_IFACE..."
    iw dev "$WIFI_IFACE" interface add "$AP_IFACE" type __ap || \
        die "Failed to create AP interface. Your driver may not support concurrent AP+STA."
    # Give it a moment
    sleep 0.5
    ip link set "$AP_IFACE" up || die "Failed to bring up $AP_IFACE."
    log "AP interface $AP_IFACE is up."
}

configure_networking() {
    log "Configuring gateway IP $GW_IP on $AP_IFACE..."
    ip addr flush dev "$AP_IFACE" 2>/dev/null || true
    ip addr add "$SUBNET" dev "$AP_IFACE" || die "Failed to assign IP to $AP_IFACE."

    # Enable IP forwarding
    log "Enabling IPv4 forwarding..."
    sysctl -w net.ipv4.ip_forward=1 >/dev/null

    # Set up NAT via iptables
    local uplink
    uplink="$(ip route show default | awk 'NR==1{for(i=1;i<=NF;i++) if($i=="dev") print $(i+1)}')"
    if [[ -z "$uplink" ]]; then
        warn "No default route found; NAT may not work."
        uplink="$WIFI_IFACE"
    fi
    log "Setting up NAT: $AP_IFACE -> $uplink"
    iptables -t nat -A POSTROUTING -o "$uplink" -j MASQUERADE 2>/dev/null || true
    iptables -A FORWARD -i "$AP_IFACE" -o "$uplink" -j ACCEPT 2>/dev/null || true
    iptables -A FORWARD -i "$uplink" -o "$AP_IFACE" -m state --state RELATED,ESTABLISHED -j ACCEPT 2>/dev/null || true
}

start_dnsmasq() {
    local conf="${STATE_DIR}/dnsmasq.conf"
    local pidfile="${STATE_DIR}/dnsmasq.pid"
    mkdir -p "$STATE_DIR"

    cat > "$conf" <<EOF
interface=$AP_IFACE
bind-interfaces
dhcp-range=${DHCP_START},${DHCP_END},255.255.255.0,12h
dhcp-option=option:router,${GW_IP}
dhcp-option=option:dns-server,${DNS1},${DNS2}
no-hosts
no-resolv
server=${DNS1}
server=${DNS2}
EOF
    log "Starting dnsmasq..."
    dnsmasq -C "$conf" --pid-file="$pidfile" || die "Failed to start dnsmasq."
    log "dnsmasq started (PID: $(cat "$pidfile"))."
}

write_hostapd_conf() {
    local conf="${STATE_DIR}/hostapd.conf"
    mkdir -p "$STATE_DIR"

    local hw_mode="g"
    local ieee80211n="1"
    local ieee80211ac="0"
    # If 5GHz channel (>= 36), use 'a' mode
    if [[ "$STA_CHANNEL" -ge 36 ]]; then
        hw_mode="a"
        ieee80211ac="1"
    fi

    cat > "$conf" <<EOF
interface=$AP_IFACE
driver=nl80211
ssid=$SSID
hw_mode=$hw_mode
channel=$STA_CHANNEL
ieee80211n=$ieee80211n
ieee80211ac=$ieee80211ac
wmm_enabled=1
auth_algs=1
wpa=2
wpa_key_mgmt=WPA-PSK
wpa_pairwise=CCMP
rsn_pairwise=CCMP
wpa_passphrase=$PASSWORD
EOF
    log "hostapd config written to $conf"
}

start_hostapd() {
    local conf="${STATE_DIR}/hostapd.conf"
    local pidfile="${STATE_DIR}/hostapd.pid"

    write_hostapd_conf

    log "Starting hostapd..."
    hostapd -B -P "$pidfile" "$conf" || die "Failed to start hostapd."
    log "hostapd started (PID: $(cat "$pidfile"))."
}

start_packet_engine() {
    if [[ -x "$PACKET_ENGINE" ]]; then
        log "Starting packet engine on $AP_IFACE..."
        "$PACKET_ENGINE" --iface "$AP_IFACE" --subnet "$SUBNET_PREFIX" &
        echo $! > "${STATE_DIR}/packet_engine.pid"
        log "Packet engine started (PID: $!)."
    else
        warn "Packet engine binary not found at $PACKET_ENGINE."
        warn "Build it with 'make' to enable live packet monitoring."
    fi
}

print_qr_code() {
    if [[ -x "$PACKET_ENGINE" ]]; then
        "$PACKET_ENGINE" --qr-only --ssid "$SSID" --password "$PASSWORD"
    else
        # Fallback: print text-based connection info
        echo ""
        echo "┌──────────────────────────────────────────────┐"
        echo "│           Wi-Fi Connection Details            │"
        echo "├──────────────────────────────────────────────┤"
        printf "│  SSID:      %-33s│\n" "$SSID"
        printf "│  Password:  %-33s│\n" "$PASSWORD"
        printf "│  Gateway:   %-33s│\n" "$GW_IP"
        echo "│                                              │"
        echo "│  (Build packet_engine with 'make' for QR)    │"
        echo "└──────────────────────────────────────────────┘"
        echo ""
    fi
}

save_state() {
    mkdir -p "$STATE_DIR"
    cat > "${STATE_DIR}/state.env" <<EOF
AP_IFACE=$AP_IFACE
WIFI_IFACE=$WIFI_IFACE
GW_IP=$GW_IP
SUBNET=$SUBNET
SUBNET_PREFIX=$SUBNET_PREFIX
EOF
}

# ── Start ─────────────────────────────────────────────────────────────────────
do_start() {
    require_root
    load_conf
    detect_wifi_iface
    detect_sta_channel
    check_ap_support
    pick_ap_iface

    # Check dependencies
    command -v hostapd >/dev/null 2>&1 || die "hostapd not installed (apt install hostapd)."
    command -v dnsmasq >/dev/null 2>&1 || die "dnsmasq not installed (apt install dnsmasq)."
    command -v iw      >/dev/null 2>&1 || die "iw not installed (apt install iw)."

    create_ap_interface
    configure_networking
    start_dnsmasq
    start_hostapd
    start_packet_engine
    save_state

    echo ""
    log "════════════════════════════════════════════════"
    log "  Hotspot is ACTIVE"
    log "  SSID:       $SSID"
    log "  Password:   $PASSWORD"
    log "  Gateway:    $GW_IP"
    log "  Channel:    $STA_CHANNEL"
    log "  AP Iface:   $AP_IFACE"
    log "════════════════════════════════════════════════"

    print_qr_code

    log "Press Ctrl+C to stop."

    # Trap SIGINT/SIGTERM to do clean shutdown
    trap 'do_stop_internal; exit 0' INT TERM

    # Wait forever (keep script alive for Ctrl+C)
    while true; do
        sleep 3600 &
        wait $! 2>/dev/null || break
    done
}

# ── Stop ──────────────────────────────────────────────────────────────────────
safe_kill() {
    local pidfile="$1"
    if [[ -f "$pidfile" ]]; then
        local pid
        pid="$(cat "$pidfile" 2>/dev/null || true)"
        if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
            kill "$pid" 2>/dev/null || true
            sleep 0.5
            kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null || true
        fi
        rm -f "$pidfile"
    fi
}

do_stop_internal() {
    log "Stopping hotspot..."

    # Kill packet engine
    safe_kill "${STATE_DIR}/packet_engine.pid"

    # Kill hostapd
    safe_kill "${STATE_DIR}/hostapd.pid"

    # Kill dnsmasq
    safe_kill "${STATE_DIR}/dnsmasq.pid"

    # Load state to get AP_IFACE
    if [[ -f "${STATE_DIR}/state.env" ]]; then
        # shellcheck disable=SC1091
        source "${STATE_DIR}/state.env"
    fi

    # Remove iptables rules
    local uplink
    uplink="$(ip route show default | awk 'NR==1{for(i=1;i<=NF;i++) if($i=="dev") print $(i+1)}')"
    if [[ -n "$uplink" && -n "${AP_IFACE:-}" ]]; then
        iptables -t nat -D POSTROUTING -o "$uplink" -j MASQUERADE 2>/dev/null || true
        iptables -D FORWARD -i "$AP_IFACE" -o "$uplink" -j ACCEPT 2>/dev/null || true
        iptables -D FORWARD -i "$uplink" -o "$AP_IFACE" -m state --state RELATED,ESTABLISHED -j ACCEPT 2>/dev/null || true
    fi

    # Remove AP interface
    if [[ -n "${AP_IFACE:-}" ]]; then
        ip link set "$AP_IFACE" down 2>/dev/null || true
        iw dev "$AP_IFACE" del 2>/dev/null || true
        log "Removed AP interface $AP_IFACE."
    fi

    rm -rf "$STATE_DIR"
    log "Hotspot stopped."
}

do_stop() {
    require_root
    load_conf
    do_stop_internal
}

# ── Status ────────────────────────────────────────────────────────────────────
do_status() {
    if [[ ! -f "${STATE_DIR}/state.env" ]]; then
        log "Hotspot is not running."
        exit 1
    fi
    # shellcheck disable=SC1091
    source "${STATE_DIR}/state.env"

    echo ""
    log "Hotspot Status:"
    log "  AP Interface:  ${AP_IFACE:-unknown}"
    log "  Wi-Fi Iface:   ${WIFI_IFACE:-unknown}"
    log "  Gateway:       ${GW_IP:-unknown}"
    log "  Subnet:        ${SUBNET:-unknown}"

    # Show connected clients via ARP
    echo ""
    log "Connected Clients:"
    if command -v arp >/dev/null 2>&1; then
        arp -i "${AP_IFACE:-ap0}" -n 2>/dev/null | tail -n +2 || echo "  (none)"
    else
        ip neigh show dev "${AP_IFACE:-ap0}" 2>/dev/null || echo "  (none)"
    fi

    # Show DHCP leases if available
    local leasefile="/var/lib/misc/dnsmasq.leases"
    if [[ -f "$leasefile" ]]; then
        echo ""
        log "DHCP Leases:"
        cat "$leasefile"
    fi
    echo ""
}

# ── QR ────────────────────────────────────────────────────────────────────────
do_qr() {
    load_conf
    print_qr_code
}

# ── Main ──────────────────────────────────────────────────────────────────────
case "${1:-start}" in
    start)  do_start ;;
    stop)   do_stop  ;;
    status) do_status ;;
    qr)     do_qr    ;;
    -h|--help)
        echo "Usage: sudo $0 {start|stop|status|qr}"
        echo ""
        echo "Commands:"
        echo "  start   Start the same-channel Wi-Fi hotspot"
        echo "  stop    Stop the hotspot and clean up"
        echo "  status  Show hotspot status and connected clients"
        echo "  qr      Display the Wi-Fi QR code"
        ;;
    *)
        die "Unknown command: $1 (use: start|stop|status|qr)"
        ;;
esac

